meta {
  name: Create image without alternative text
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/article-images
  body: json
  auth: none
}

body:json {
  {
    "articleId": 4,
    "url": "/images/x.jpg"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  POST /article-images

  Accessibility: `altText` is required.
}
