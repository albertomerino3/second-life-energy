meta {
  name: Get article image by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/article-images/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });
}

docs {
  GET /article-images/1

  Returns one record of `article-images` with its relationships.
}
