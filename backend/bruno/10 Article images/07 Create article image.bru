meta {
  name: Create article image
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/article-images
  body: json
  auth: none
}

body:json {
  {
    "articleId": 4,
    "url": "/images/articles/bruno-{{uniq}}.jpg",
    "altText": "Imagen de prueba creada desde Bruno",
    "sortOrder": 0
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("articleImageId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /article-images

  Creates a record in `article-images`. The id is saved in the variable `articleImageId`.
}
