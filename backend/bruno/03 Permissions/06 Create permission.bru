meta {
  name: Create permission
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/permissions
  body: json
  auth: none
}

body:json {
  {
    "code": "bruno.permission-{{uniq}}",
    "description": "Permiso creado desde Bruno"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("permissionId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /permissions

  Creates a record in `permissions`. The id is saved in the variable `permissionId`.
}
