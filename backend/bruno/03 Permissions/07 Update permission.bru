meta {
  name: Update permission
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/permissions/{{permissionId}}
  body: json
  auth: none
}

body:json {
  {
    "description": "Permiso editado desde Bruno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /permissions/{{permissionId}}

  Updates only the editable fields of `permissions`.
}
