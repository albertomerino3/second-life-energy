meta {
  name: Get role by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/roles/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes permissions and users", function () {
    expect(res.getBody().permissions).to.be.an("array"); expect(res.getBody().users).to.be.an("array");
  });
}

docs {
  GET /roles/1

  Returns one record of `roles` with its relationships.
}
