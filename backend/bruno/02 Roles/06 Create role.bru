meta {
  name: Create role
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: none
}

body:json {
  {
    "name": "bruno-role-{{uniq}}",
    "description": "Rol creado desde Bruno"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("roleId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /roles

  Creates a record in `roles`. The id is saved in the variable `roleId`.
}
