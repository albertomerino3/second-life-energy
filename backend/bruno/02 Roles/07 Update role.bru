meta {
  name: Update role
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/roles/{{roleId}}
  body: json
  auth: none
}

body:json {
  {
    "description": "Rol editado desde Bruno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /roles/{{roleId}}

  Updates only the editable fields of `roles`.
}
