meta {
  name: List simulations with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/simulations?platform=falstad
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only Falstad", function () {
    res.getBody().forEach((s) => expect(s.platform).to.equal("falstad"));
  });
}

docs {
  GET /simulations?platform=falstad

  Filters by `platform` (falstad | wokwi).
}
