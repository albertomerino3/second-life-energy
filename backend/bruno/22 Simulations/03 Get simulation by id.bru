meta {
  name: Get simulation by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/simulations/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes related articles and resources", function () {
    expect(res.getBody().articles).to.be.an("array").that.is.not.empty; expect(res.getBody().resources).to.be.an("array").that.is.not.empty;
  });
}

docs {
  GET /simulations/1

  Returns one record of `simulations` with its relationships.
}
