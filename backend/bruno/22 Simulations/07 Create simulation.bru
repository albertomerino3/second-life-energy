meta {
  name: Create simulation
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/simulations
  body: json
  auth: none
}

body:json {
  {
    "title": "Simulación Bruno {{uniq}}",
    "description": "Creada desde Bruno",
    "platform": "wokwi",
    "url": "https://wokwi.com/projects/new/arduino-uno",
    "objectives": "Probar la API",
    "materials": "Ninguno"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("simulationId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /simulations

  Creates a record in `simulations`. The id is saved in the variable `simulationId`.
}
