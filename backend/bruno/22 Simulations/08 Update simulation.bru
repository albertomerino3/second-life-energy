meta {
  name: Update simulation
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/simulations/{{simulationId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Simulación Bruno editada"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /simulations/{{simulationId}}

  Updates only the editable fields of `simulations`.
}
