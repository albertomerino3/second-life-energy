meta {
  name: Update audit log
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/audit-logs/{{auditLogId}}
  body: json
  auth: none
}

body:json {
  {
    "action": "publish"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /audit-logs/{{auditLogId}}

  Updates only the editable fields of `audit-logs`.
}
