meta {
  name: Get audit log by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/audit-logs/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes the user", function () {
    expect(res.getBody().user).to.be.an("object");
  });
}

docs {
  GET /audit-logs/1

  Returns one record of `audit-logs` with its relationships.
}
