meta {
  name: Create simulation resource
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/simulation-resources
  body: json
  auth: none
}

body:json {
  {
    "simulationId": 2,
    "resourceId": 5
  }
}

assert {
  res.status: eq 201
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the composite key", function () {
    expect(res.getBody().simulationId).to.equal(2); expect(res.getBody().resourceId).to.equal(5);
  });
}

docs {
  POST /simulation-resources

  Creates the relationship. The composite key (simulationId, resourceId) identifies it.
}
