meta {
  name: List simulation-resources
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/simulation-resources
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("is not empty", function () {
    expect(res.getBody().length).to.be.greaterThan(0);
  });
}

docs {
  GET /simulation-resources

  Returns every relationship of `simulation-resources` with both related records.
}
