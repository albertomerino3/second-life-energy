meta {
  name: Create simulation resource duplicated
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/simulation-resources
  body: json
  auth: none
}

body:json {
  {
    "simulationId": 2,
    "resourceId": 5
  }
}

assert {
  res.status: eq 409
}

tests {
  test("responds 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  POST /simulation-resources

  The same relationship cannot be created twice (primary key).
}
