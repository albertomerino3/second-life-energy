meta {
  name: Get forum category by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/forum-categories/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes its visible questions", function () {
    expect(res.getBody().questions).to.be.an("array");
  });
}

docs {
  GET /forum-categories/1

  Returns one record of `forum-categories` with its relationships.
}
