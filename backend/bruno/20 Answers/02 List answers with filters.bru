meta {
  name: List answers with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/answers?questionId=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only answers of question 1", function () {
    res.getBody().forEach((a) => expect(a.questionId).to.equal(1));
  });
}

docs {
  GET /answers?questionId=1

  Filters by `questionId`.
}
