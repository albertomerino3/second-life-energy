meta {
  name: List answers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/answers
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("is not empty", function () {
    expect(res.getBody().length).to.be.greaterThan(0);
  });
}

docs {
  GET /answers

  Returns every record of `answers` ordered by id, with its related data (include).
}
