meta {
  name: Update answer
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/answers/{{answerId}}
  body: json
  auth: none
}

body:json {
  {
    "content": "Respuesta editada desde Bruno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /answers/{{answerId}}

  Updates only the editable fields of `answers`.
}
