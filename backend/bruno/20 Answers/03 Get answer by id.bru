meta {
  name: Get answer by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/answers/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes author and question", function () {
    expect(res.getBody().author).to.be.an("object"); expect(res.getBody().question).to.be.an("object");
  });
}

docs {
  GET /answers/1

  Returns one record of `answers` with its relationships.
}
