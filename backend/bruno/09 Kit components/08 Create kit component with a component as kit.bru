meta {
  name: Create kit component with a component as kit
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/kit-components
  body: json
  auth: none
}

body:json {
  {
    "kitId": 4,
    "componentId": 9
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  POST /kit-components

  `kitId` must be an article of type kit.
}
