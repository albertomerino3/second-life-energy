meta {
  name: Create kit component duplicated
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/kit-components
  body: json
  auth: none
}

body:json {
  {
    "kitId": 2,
    "componentId": 9,
    "quantity": 2
  }
}

assert {
  res.status: eq 409
}

tests {
  test("responds 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  POST /kit-components

  The same relationship cannot be created twice (primary key).
}
