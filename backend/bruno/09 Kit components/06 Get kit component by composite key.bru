meta {
  name: Get kit component by composite key
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/kit-components/2/9
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("includes kit and component", function () {
    expect(res.getBody().kit.type).to.equal("kit"); expect(res.getBody().component.type).to.equal("component");
  });
}
