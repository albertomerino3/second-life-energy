meta {
  name: Create kit component
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/kit-components
  body: json
  auth: none
}

body:json {
  {
    "kitId": 2,
    "componentId": 9,
    "quantity": 2
  }
}

assert {
  res.status: eq 201
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the composite key", function () {
    expect(res.getBody().kitId).to.equal(2); expect(res.getBody().componentId).to.equal(9);
  });
}

docs {
  POST /kit-components

  Creates the relationship. The composite key (kitId, componentId) identifies it.
}
