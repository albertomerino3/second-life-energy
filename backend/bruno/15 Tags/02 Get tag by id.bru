meta {
  name: Get tag by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/tags/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes its resources", function () {
    expect(res.getBody().resources).to.be.an("array");
  });
}

docs {
  GET /tags/1

  Returns one record of `tags` with its relationships.
}
