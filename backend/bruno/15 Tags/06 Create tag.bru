meta {
  name: Create tag
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/tags
  body: json
  auth: none
}

body:json {
  {
    "name": "Etiqueta Bruno {{uniq}}",
    "slug": "etiqueta-bruno-{{uniq}}"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("tagId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /tags

  Creates a record in `tags`. The id is saved in the variable `tagId`.
}
