meta {
  name: Update tag
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/tags/{{tagId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Etiqueta Bruno editada {{uniq}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /tags/{{tagId}}

  Updates only the editable fields of `tags`.
}
