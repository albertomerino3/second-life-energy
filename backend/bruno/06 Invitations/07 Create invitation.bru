meta {
  name: Create invitation
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/invitations
  body: json
  auth: none
}

body:json {
  {
    "invitedById": 2,
    "roleId": 3,
    "email": "invitado.{{uniq}}@second-life-energy.test",
    "tokenHash": "bruno-token-{{uniq}}",
    "expiresAt": "2030-01-01T00:00:00.000Z"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("invitationId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /invitations

  Creates a record in `invitations`. The id is saved in the variable `invitationId`.
}
