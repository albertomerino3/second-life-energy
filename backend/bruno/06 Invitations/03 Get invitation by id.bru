meta {
  name: Get invitation by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/invitations/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes who invited and the role", function () {
    expect(res.getBody().invitedBy).to.be.an("object"); expect(res.getBody().role).to.be.an("object");
  });
}

docs {
  GET /invitations/1

  Returns one record of `invitations` with its relationships.
}
