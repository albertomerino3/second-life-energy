meta {
  name: Update request
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/requests/{{requestId}}
  body: json
  auth: none
}

body:json {
  {
    "status": "confirmed"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("is confirmed", function () {
    expect(res.getBody().status).to.equal("confirmed");
  });
}

docs {
  PUT /requests/{{requestId}}

  Updates only the editable fields of `requests`.
}
