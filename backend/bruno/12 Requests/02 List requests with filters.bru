meta {
  name: List requests with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/requests?status=confirmed
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only confirmed requests", function () {
    res.getBody().forEach((r) => expect(r.status).to.equal("confirmed"));
  });
}

docs {
  GET /requests?status=confirmed

  Filters by `status` (draft | confirmed | cancelled).
}
