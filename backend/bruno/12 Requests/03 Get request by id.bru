meta {
  name: Get request by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/requests/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes items with their article", function () {
    const r = res.getBody(); expect(r.items).to.be.an("array").that.is.not.empty; expect(r.items[0].article).to.be.an("object");
  });
}

docs {
  GET /requests/1

  Returns one record of `requests` with its relationships.
}
