meta {
  name: Unknown route
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/does-not-exist
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("responds 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("has a message", function () {
    expect(res.getBody().message).to.equal("Route not found");
  });
}
