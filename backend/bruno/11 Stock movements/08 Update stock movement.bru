meta {
  name: Update stock movement
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/stock-movements/{{stockMovementId}}
  body: json
  auth: none
}

body:json {
  {
    "reason": "Entrada corregida desde Bruno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /stock-movements/{{stockMovementId}}

  Updates only the editable fields of `stock-movements`.
}
