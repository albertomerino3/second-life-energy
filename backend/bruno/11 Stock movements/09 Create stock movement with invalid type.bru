meta {
  name: Create stock movement with invalid type
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "articleId": 4,
    "userId": 3,
    "type": "gift",
    "quantity": 1
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
