meta {
  name: Create stock movement
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/stock-movements
  body: json
  auth: none
}

body:json {
  {
    "articleId": 4,
    "userId": 3,
    "type": "in",
    "quantity": 3,
    "reason": "Entrada de prueba desde Bruno"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("stockMovementId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /stock-movements

  Creates a record in `stock-movements`. The id is saved in the variable `stockMovementId`.
}
