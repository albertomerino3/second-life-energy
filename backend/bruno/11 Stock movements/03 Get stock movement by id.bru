meta {
  name: Get stock movement by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/stock-movements/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes article and user", function () {
    expect(res.getBody().article).to.be.an("object"); expect(res.getBody().user).to.be.an("object");
  });
}

docs {
  GET /stock-movements/1

  Returns one record of `stock-movements` with its relationships.
}
