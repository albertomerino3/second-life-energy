meta {
  name: List stock-movements with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/stock-movements?articleId=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only movements of article 1", function () {
    res.getBody().forEach((m) => expect(m.articleId).to.equal(1));
  });
}

docs {
  GET /stock-movements?articleId=1

  Filters by `articleId`.
}
