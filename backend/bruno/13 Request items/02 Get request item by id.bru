meta {
  name: Get request item by id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/request-items/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes request and article", function () {
    expect(res.getBody().request).to.be.an("object"); expect(res.getBody().article).to.be.an("object");
  });
}

docs {
  GET /request-items/1

  Returns one record of `request-items` with its relationships.
}
