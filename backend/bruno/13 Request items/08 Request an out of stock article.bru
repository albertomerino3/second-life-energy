meta {
  name: Request an out of stock article
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/request-items
  body: json
  auth: none
}

body:json {
  {
    "requestId": 2,
    "articleId": 2,
    "quantity": 1
  }
}

assert {
  res.status: eq 409
}

tests {
  test("responds 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  POST /request-items

  HU-03: out of stock articles cannot be requested.
}
