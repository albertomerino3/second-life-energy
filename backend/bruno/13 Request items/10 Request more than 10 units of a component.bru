meta {
  name: Request more than 10 units of a component
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/request-items
  body: json
  auth: none
}

body:json {
  {
    "requestId": 2,
    "articleId": 9,
    "quantity": 11
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  POST /request-items

  HU-04: max. 10 units per component.
}
