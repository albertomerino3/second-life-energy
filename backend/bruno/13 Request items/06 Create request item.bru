meta {
  name: Create request item
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/request-items
  body: json
  auth: none
}

body:json {
  {
    "requestId": 2,
    "articleId": 5,
    "quantity": 3
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("requestItemId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /request-items

  Creates a record in `request-items`. The id is saved in the variable `requestItemId`.
}
