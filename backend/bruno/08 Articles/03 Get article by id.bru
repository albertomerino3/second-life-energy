meta {
  name: Get article by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/articles/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("has the requested id", function () {
    expect(res.getBody().id).to.equal(1);
  });

  test("includes category, images and components", function () {
    const a = res.getBody(); expect(a.category.name).to.be.a("string"); expect(a.images).to.be.an("array").that.is.not.empty; expect(a.components).to.be.an("array").that.is.not.empty;
  });

  test("includes related resources and simulations", function () {
    expect(res.getBody().resources).to.be.an("array"); expect(res.getBody().simulations).to.be.an("array");
  });
}

docs {
  GET /articles/1

  Returns one record of `articles` with its relationships.
}
