meta {
  name: Out of stock articles are listed
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/articles?available=false
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("is not empty", function () {
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("stock is 0", function () {
    res.getBody().forEach((a) => expect(a.stock).to.equal(0));
  });
}

docs {
  GET /articles?available=false

  HU-03: out of stock articles are visible in the catalogue.
}
