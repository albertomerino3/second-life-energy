meta {
  name: Create article with invalid type
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/articles
  body: json
  auth: none
}

body:json {
  {
    "categoryId": 5,
    "createdById": 3,
    "name": "Mal",
    "description": "Tipo incorrecto",
    "type": "laptop"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
