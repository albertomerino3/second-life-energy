meta {
  name: Create article category
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/article-categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Categoría Bruno {{uniq}}",
    "description": "Subcategoría de componentes",
    "parentCategoryId": 2
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("articleCategoryId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}

docs {
  POST /article-categories

  Creates a record in `article-categories`. The id is saved in the variable `articleCategoryId`.
}
