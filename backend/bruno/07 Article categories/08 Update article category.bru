meta {
  name: Update article category
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/article-categories/{{articleCategoryId}}
  body: json
  auth: none
}

body:json {
  {
    "description": "Categoría editada desde Bruno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /article-categories/{{articleCategoryId}}

  Updates only the editable fields of `article-categories`.
}
