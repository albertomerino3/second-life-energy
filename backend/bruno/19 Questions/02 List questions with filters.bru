meta {
  name: List questions with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/questions?categoryId=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only category 2", function () {
    res.getBody().forEach((q) => expect(q.categoryId).to.equal(2));
  });
}

docs {
  GET /questions?categoryId=2

  HU-09: `search`, `categoryId` and `status`.
}
