meta {
  name: Update article review
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/article-reviews/{{articleReviewId}}
  body: json
  auth: none
}

body:json {
  {
    "comments": "Revisión editada desde Bruno"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /article-reviews/{{articleReviewId}}

  Updates only the editable fields of `article-reviews`.
}
