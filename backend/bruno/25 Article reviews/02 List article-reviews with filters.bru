meta {
  name: List article-reviews with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/article-reviews?decision=returned
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only returned", function () {
    res.getBody().forEach((r) => expect(r.decision).to.equal("returned"));
  });
}

docs {
  GET /article-reviews?decision=returned

  Filters by `articleId` and `decision`.
}
