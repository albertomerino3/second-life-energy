meta {
  name: Create resource
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/resources
  body: json
  auth: none
}

body:json {
  {
    "authorId": 2,
    "title": "Recurso Bruno {{uniq}}",
    "description": "Recurso creado desde Bruno",
    "type": "video",
    "topic": "Medición",
    "difficulty": "beginner",
    "url": "https://www.youtube.com/",
    "status": "published"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("resourceId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });

  test("published resources have a publication date", function () {
    expect(res.getBody().publishedAt).to.not.equal(null);
  });
}

docs {
  POST /resources

  Creates a record in `resources`. The id is saved in the variable `resourceId`.
}
