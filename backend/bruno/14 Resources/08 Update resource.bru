meta {
  name: Update resource
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/resources/{{resourceId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Recurso Bruno editado"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  PUT /resources/{{resourceId}}

  Updates only the editable fields of `resources`.
}
