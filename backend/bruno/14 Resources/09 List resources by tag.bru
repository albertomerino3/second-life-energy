meta {
  name: List resources by tag
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/resources?tag=seguridad
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("is not empty", function () {
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("all have the tag", function () {
    res.getBody().forEach((r) => expect(r.tags.map((x) => x.slug)).to.include("seguridad"));
  });
}
