meta {
  name: Create user
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Usuario Bruno",
    "email": "bruno.{{uniq}}@second-life-energy.test",
    "passwordHash": "$2a$10$hYvgPCvMCddgj6p/.Efuwu7B73KqSjE8OFyPiqcJhO/fS8wDtKp8G",
    "isActive": true
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("uniq", Date.now());
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("userId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the new id", function () {
    expect(res.getBody().id).to.be.a("number");
  });

  test("never returns the password hash", function () {
    expect(res.getBody()).to.not.have.property("passwordHash");
  });
}

docs {
  POST /users

  Creates a record in `users`. The id is saved in the variable `userId`.
}
