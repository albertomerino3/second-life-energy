meta {
  name: Update user
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: none
}

body:json {
  {
    "name": "Usuario Bruno (editado)",
    "isActive": false
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("never returns the password hash", function () {
    expect(res.getBody()).to.not.have.property("passwordHash");
  });

  test("is now inactive", function () {
    expect(res.getBody().isActive).to.equal(false);
  });
}

docs {
  PUT /users/{{userId}}

  Updates only the editable fields of `users`.
}
