meta {
  name: List users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("is not empty", function () {
    expect(res.getBody().length).to.be.greaterThan(0);
  });

  test("never returns password hashes", function () {
    res.getBody().forEach((u) => expect(u).to.not.have.property("passwordHash"));
  });
}

docs {
  GET /users

  Returns every record of `users` ordered by id, with its related data (include).
}
