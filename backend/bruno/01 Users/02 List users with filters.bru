meta {
  name: List users with filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users?isActive=false
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("only inactive users", function () {
    res.getBody().forEach((u) => expect(u.isActive).to.equal(false));
  });
}

docs {
  GET /users?isActive=false

  Filters users by `isActive`.
}
