meta {
  name: Create user with invalid email
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "name": "Email mal",
    "email": "no-es-un-email",
    "passwordHash": "x"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("responds 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
