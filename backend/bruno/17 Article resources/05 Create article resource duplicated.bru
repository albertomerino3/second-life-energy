meta {
  name: Create article resource duplicated
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/article-resources
  body: json
  auth: none
}

body:json {
  {
    "articleId": 5,
    "resourceId": 4
  }
}

assert {
  res.status: eq 409
}

tests {
  test("responds 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  POST /article-resources

  The same relationship cannot be created twice (primary key).
}
