meta {
  name: Create article resource
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/article-resources
  body: json
  auth: none
}

body:json {
  {
    "articleId": 5,
    "resourceId": 4
  }
}

assert {
  res.status: eq 201
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the composite key", function () {
    expect(res.getBody().articleId).to.equal(5); expect(res.getBody().resourceId).to.equal(4);
  });
}

docs {
  POST /article-resources

  Creates the relationship. The composite key (articleId, resourceId) identifies it.
}
