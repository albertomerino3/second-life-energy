meta {
  name: Hide an answer
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/moderations
  body: json
  auth: none
}

body:json {
  {
    "moderatorId": 2,
    "answerId": 3,
    "action": "hide",
    "reason": "Prueba de moderación desde Bruno"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("hideModerationId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("answer is hidden", function () {
    expect(res.getBody().answer.status).to.equal("hidden");
  });
}
