meta {
  name: Restore the answer
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/moderations
  body: json
  auth: none
}

body:json {
  {
    "moderatorId": 2,
    "answerId": 3,
    "action": "restore",
    "reason": "Restaurada tras revisión"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() < 300) { bru.setVar("restoreModerationId", res.getBody().id); }
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("answer is published again", function () {
    expect(res.getBody().answer.status).to.equal("published");
  });
}
