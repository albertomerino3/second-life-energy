meta {
  name: Update moderation reason
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/moderations/{{restoreModerationId}}
  body: json
  auth: none
}

body:json {
  {
    "reason": "Motivo corregido"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("reason updated", function () {
    expect(res.getBody().reason).to.equal("Motivo corregido");
  });
}
