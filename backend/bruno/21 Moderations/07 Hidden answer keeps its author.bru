meta {
  name: Hidden answer keeps its author
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/answers/3
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("status hidden and same author", function () {
    expect(res.getBody().status).to.equal("hidden"); expect(res.getBody().authorId).to.equal(3);
  });
}
