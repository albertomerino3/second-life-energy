meta {
  name: List permissions of a role
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/role-permissions/role/3
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an array", function () {
    expect(res.getBody()).to.be.an("array");
  });

  test("is not empty", function () {
    expect(res.getBody().length).to.be.greaterThan(0);
  });
}
