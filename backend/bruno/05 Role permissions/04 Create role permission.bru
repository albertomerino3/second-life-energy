meta {
  name: Create role permission
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/role-permissions
  body: json
  auth: none
}

body:json {
  {
    "roleId": 3,
    "permissionId": 7
  }
}

assert {
  res.status: eq 201
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the composite key", function () {
    expect(res.getBody().roleId).to.equal(3); expect(res.getBody().permissionId).to.equal(7);
  });
}

docs {
  POST /role-permissions

  Creates the relationship. The composite key (roleId, permissionId) identifies it.
}
