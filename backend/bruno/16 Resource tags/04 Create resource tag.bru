meta {
  name: Create resource tag
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/resource-tags
  body: json
  auth: none
}

body:json {
  {
    "resourceId": 2,
    "tagId": 1
  }
}

assert {
  res.status: eq 201
}

tests {
  test("responds 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns the composite key", function () {
    expect(res.getBody().resourceId).to.equal(2); expect(res.getBody().tagId).to.equal(1);
  });
}

docs {
  POST /resource-tags

  Creates the relationship. The composite key (resourceId, tagId) identifies it.
}
