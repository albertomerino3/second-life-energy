meta {
  name: Create resource tag duplicated
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/resource-tags
  body: json
  auth: none
}

body:json {
  {
    "resourceId": 2,
    "tagId": 1
  }
}

assert {
  res.status: eq 409
}

tests {
  test("responds 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  POST /resource-tags

  The same relationship cannot be created twice (primary key).
}
